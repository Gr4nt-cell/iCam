<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Camera UI for the phone's back screen (opened on that display; root used where required) -->
    <activity
      android:name="expo.modules.icamera.RearScreenActivity"
      android:exported="false"
      android:resizeableActivity="true"
      android:launchMode="singleInstance"
      android:taskAffinity="com.gr4nt.icam.rear"
      android:excludeFromRecents="true"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
      android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
  </application>
</manifest>
