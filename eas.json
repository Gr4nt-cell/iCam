{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "env": {
        "ICAM_VERSION_CODE": "170"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local",
        "image": "latest"
      }
    },
    "production": {
      "env": {
        "ICAM_VERSION_CODE": "170"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "image": "latest"
      }
    }
  }
}