{
  "expo": {
    "name": "iCam",
    "slug": "icam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "android": {
      "package": "com.gr4nt.icam",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "iCam needs the camera to take photos and videos.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "iCam needs the microphone to record sound with your videos.",
          "enableLocation": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "iCam saves your photos and videos to your gallery.",
          "savePhotosPermission": "iCam saves your photos and videos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": false
          }
        }
      ]
    ]
  }
}
